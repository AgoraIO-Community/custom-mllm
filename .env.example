XAI_API_KEY=xai-...
XAI_MODEL=grok-voice-latest
XAI_CHAT_MODEL=grok-4.3
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-realtime
OPENAI_CHAT_MODEL=gpt-4o-mini
# Shared with Next.js — HMAC per-debate auth (empty = dev open)
PROXY_MASTER_SECRET=
PORT=8081
LOG_LEVEL=info
LOG_AUDIO=0
HOST=0.0.0.0
# LLM KB: max points injected per side per chat turn (0 = unlimited)
KB_INJECT_MAX_POINTS_PER_SIDE=30
# Side-specific audit logs under this directory (empty = disabled)
KB_AUDIT_LOG_DIR=logs
